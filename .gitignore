# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# prisma generated client (regenerated via `prisma generate`)
/app/generated

# env files (never commit secrets)
.env
.env*.local

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo

# maintainer-local working docs (operating truth, kept out of the repo by choice)
/PROJECT.md
/DATA.md

# enrichment batches are the maintainer's working data: internal research notes on
# named businesses, kept local. The pipeline that applies them ships in the repo
# (scripts/apply-enrichment.ts, .github/workflows/enrich.yml); the batch files don't.
/data/enrichment/*.json
