# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Postgres connection string. Get a free one at https://neon.tech.
# Use the POOLED connection string in production (serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Absolute, public-facing site URL (no trailing slash). Used for canonical
# URLs, sitemap.xml, and Open Graph tags. In production set your real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only n8n webhook that the contact form (/api/contact) posts to; n8n
# fans out to Resend and emails the maintainer. No NEXT_PUBLIC prefix — this
# must never reach the browser. The workflow must be ACTIVE for this URL to work.
N8N_CONTACT_WEBHOOK_URL="https://steadro.app.n8n.cloud/webhook/mcg-contact"

# Server-only n8n webhook for the structured "Add your business" intake form
# (/api/intake). OPTIONAL: the submission is always saved to the DB first and
# shows in the admin Intake tab regardless. This webhook is the async layer for
# notifications and future Claude-API triage. Leave blank to skip the ping.
N8N_INTAKE_WEBHOOK_URL=""

# Shared bearer token for the (future) automation callback POST
# /api/intake/[id]/analysis, where an n8n→Claude flow writes its analysis back
# onto a submission. Endpoint returns 503 until this is set. Use the same value
# in n8n. Generate any long random string.
INTAKE_ANALYSIS_TOKEN=""

# Public flag for the temporary "Add your business" acquisition banner shown
# under the header. Inlined at build time. Default (unset) = shown. Set to
# "false" to retire the banner without a code change (redeploy to apply).
NEXT_PUBLIC_SHOW_INTAKE_CTA="true"

# ---------------------------------------------------------------------------
# Admin login (/admin) — single curator credential for editing DB entries.
# Generate ADMIN_PASSWORD_HASH and SESSION_SECRET in one shot:
#   npx tsx scripts/hash-password.ts "your-strong-password"
# Then paste the three lines it prints here (and into Vercel's project env).
# The plaintext password is NEVER stored; only the scrypt hash. SESSION_SECRET
# signs the session cookie (HMAC) — keep it secret, rotate it to log everyone out.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Geocoding (optional) — fills latitude/longitude at seed time so business
# pages can render a map. Leave GEOCODER blank to skip (pages still work; the
# map is simply hidden). Choose ONE provider:
#   GEOCODER=google  -> https://developers.google.com/maps/documentation/geocoding
#   GEOCODER=mapbox  -> https://docs.mapbox.com/api/search/geocoding
# ---------------------------------------------------------------------------
GEOCODER=""
GOOGLE_GEOCODING_API_KEY=""
MAPBOX_TOKEN=""
