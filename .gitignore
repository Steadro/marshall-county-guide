# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# prisma generated client (regenerated via `prisma generate`)
/app/generated

# env files (never commit secrets)
.env
.env*.local

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo

# auto-enrich watcher logs (local runtime output)
/scripts/logs/

# maintainer-local working docs (operating truth, kept out of the repo by choice)
/PROJECT.md
/DATA.md

# Enrichment batches are the maintainer's local working data: research notes on
# named businesses, kept off GitHub. The pipeline that applies them ships in the
# repo (scripts/apply-enrichment.ts + scripts/auto-enrich-push.ps1); the batch
# files and their applied archive do not. Neon is the system of record.
/data/enrichment/*.json
/data/enrichment/.applied/

# research / scratch data outputs (regenerated locally, not source)
/data/coverage-scan-*.json
# Live-DB exports: full snapshots incl. internalContext (internal-only). Local
# research artifacts, never committed (public repo). Regenerate from Neon.
/data/businesses-export-*.csv

# redundant binary seed (the CSV is authoritative)
*.xlsx

# Local-only scratch (kept off the public repo by convention; never the running app)
# Underscore-prefixed scripts are one-off research/ops tools — their effects land
# in Neon, the scripts themselves stay local.
/scripts/_*.ts
# Working data dirs: gold staging + per-business enrichment research records.
/data/_gold-staging/
/data/enrichment/_records/
# Root-level logo/favicon SOURCE files. The SERVED assets live in /public.
/images/
