# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Postgres connection string. Get a free one at https://neon.tech.
# Use the POOLED connection string in production (serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Absolute, public-facing site URL (no trailing slash). Used for canonical
# URLs, sitemap.xml, and Open Graph tags. In production set your real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only n8n webhook that the contact form (/api/contact) posts to; n8n
# fans out to Resend and emails the maintainer. No NEXT_PUBLIC prefix — this
# must never reach the browser. The workflow must be ACTIVE for this URL to work.
N8N_CONTACT_WEBHOOK_URL="https://steadro.app.n8n.cloud/webhook/mcg-contact"

# ---------------------------------------------------------------------------
# Geocoding (optional) — fills latitude/longitude at seed time so business
# pages can render a map. Leave GEOCODER blank to skip (pages still work; the
# map is simply hidden). Choose ONE provider:
#   GEOCODER=google  -> https://developers.google.com/maps/documentation/geocoding
#   GEOCODER=mapbox  -> https://docs.mapbox.com/api/search/geocoding
# ---------------------------------------------------------------------------
GEOCODER=""
GOOGLE_GEOCODING_API_KEY=""
MAPBOX_TOKEN=""
